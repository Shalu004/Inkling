# ====================================================================
# INKLING — ENVIRONMENT CONFIGURATION TEMPLATE
# Copy this file to .env.local and populate with your credentials.
# Do NOT commit .env.local to Git.
# ====================================================================

# Next.js Application URL
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# AI Writing Coach Provider Configuration
# Set your Google Gemini API key to enable live cloud LLM analysis.
# If omitted, Inkling automatically runs its high-caliber pedagogical heuristic engine.
GEMINI_API_KEY=""
INKLING_AI_MODEL="gemini-1.5-flash"

# Supabase Database & Authentication Configuration (Optional for cloud sync)
# If omitted, Inkling seamlessly runs in local persistent mode using browser storage.
NEXT_PUBLIC_SUPABASE_URL=""
NEXT_PUBLIC_SUPABASE_ANON_KEY=""
SUPABASE_SERVICE_ROLE_KEY=""
